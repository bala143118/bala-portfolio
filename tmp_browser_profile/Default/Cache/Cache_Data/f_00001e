<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Balamurugan S // Cyber Security</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=JetBrains+Mono:wght@300;400;500;700&family=Oxanium:wght@400;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#05080a; --bg2:#0a1014; --panel:#0c1418; --line:#14262b;
  --green:#39ff14; --cyan:#00e5ff; --amber:#ffb000; --red:#ff3b5c;
  --text:#bfe9d0; --dim:#5f8573;
  --mono:'JetBrains Mono',monospace; --disp:'Bebas Neue',sans-serif; --ui:'Oxanium',sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;overflow-x:hidden}
body{background:var(--bg);color:var(--text);font-family:var(--mono);font-size:14px;line-height:1.65;overflow-x:hidden}
body::before{content:"";position:fixed;inset:0;pointer-events:none;z-index:900;
  background:repeating-linear-gradient(0deg,rgba(0,0,0,.18) 0 1px,transparent 1px 3px)}
body::after{content:"";position:fixed;inset:0;pointer-events:none;z-index:899;
  background:radial-gradient(ellipse at center,transparent 55%,rgba(0,0,0,.65));transition:background .2s}
#matrix{position:fixed;inset:0;z-index:0;opacity:.09}
a{color:var(--cyan);text-decoration:none}
a:hover{color:var(--green)}
::selection{background:var(--green);color:#000}
::-webkit-scrollbar{width:8px}::-webkit-scrollbar-track{background:var(--bg)}::-webkit-scrollbar-thumb{background:var(--line)}

/* BIOS */
#bios{position:fixed;inset:0;background:#000;z-index:1000;padding:28px;color:var(--green);font-size:13px;overflow:hidden;cursor:pointer}
#bios .hdr{color:var(--amber);font-family:var(--ui);font-weight:700;letter-spacing:2px;margin-bottom:12px}
#bios pre{white-space:pre-wrap;font-family:var(--mono)}
#bios .ok{color:var(--green)}#bios .warn{color:var(--amber)}#bios .info{color:var(--cyan)}
#bios .skip{position:absolute;bottom:20px;right:28px;color:var(--dim)}
#bios .bar{margin-top:14px;width:min(420px,90%);height:10px;border:1px solid var(--green)}
#bios .bar i{display:block;height:100%;width:0;background:var(--green);box-shadow:0 0 10px var(--green)}
.blink{animation:blink 1s steps(1) infinite}
@keyframes blink{50%{opacity:0}}

/* NAV */
nav{position:fixed;top:0;left:0;right:0;z-index:100;display:flex;align-items:center;gap:6px;
  padding:0 16px;height:44px;background:rgba(5,8,10,.92);backdrop-filter:blur(6px);
  border-bottom:1px solid var(--green);box-shadow:0 0 18px rgba(57,255,20,.15);font-family:var(--ui)}
nav .logo{color:var(--green);font-weight:700;letter-spacing:2px;margin-right:14px;text-shadow:0 0 8px var(--green)}
nav .links{display:flex;gap:2px;flex:1;overflow-x:auto}
nav .links a{color:var(--dim);padding:4px 11px;font-size:13px;letter-spacing:1px;border:1px solid transparent;white-space:nowrap}
nav .links a:hover,nav .links a.active{color:var(--cyan);border-color:var(--cyan);background:rgba(0,229,255,.06)}
nav .sys{display:flex;gap:14px;color:var(--dim);font-size:12px;white-space:nowrap}
nav .sys b{color:var(--amber);font-weight:600}
nav .dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 8px var(--green);margin-right:6px;animation:blink 2s infinite}

main{position:relative;z-index:1}
section{max-width:1150px;margin:0 auto;padding:96px 22px 40px}
.sec-title{display:flex;align-items:baseline;gap:14px;margin-bottom:30px;border-bottom:1px dashed var(--line);padding-bottom:10px}
.sec-title .n{color:var(--amber);font-family:var(--ui);font-size:13px}
.sec-title h2{font-family:var(--disp);font-size:46px;letter-spacing:3px;color:var(--green);font-weight:400;text-shadow:0 0 12px rgba(57,255,20,.45)}
.sec-title .cmd{margin-left:auto;color:var(--dim);font-size:12px}

/* HERO */
#home{min-height:100vh;display:grid;grid-template-columns:1.05fr 1fr;gap:34px;align-items:center;padding-top:90px}
.tag{color:var(--amber);font-family:var(--ui);letter-spacing:3px;font-size:13px;margin-bottom:6px}
.glitch{font-family:var(--disp);font-size:clamp(34px,5.2vw,72px);line-height:1;color:#fff;position:relative;letter-spacing:3px;display:inline-block;white-space:nowrap}
.glitch::before,.glitch::after{content:attr(data-text);position:absolute;left:0;top:0;width:100%;overflow:hidden;white-space:nowrap}
.glitch::before{color:var(--cyan);transform:translate(-3px,0);clip-path:inset(0 0 60% 0);animation:g1 3s infinite steps(1)}
.glitch::after{color:var(--red);transform:translate(3px,0);clip-path:inset(55% 0 0 0);animation:g2 2.6s infinite steps(1)}
@keyframes g1{0%,88%,100%{transform:translate(-2px,0);clip-path:inset(0 0 60% 0)}90%{transform:translate(-8px,2px);clip-path:inset(10% 0 40% 0)}94%{transform:translate(6px,-2px);clip-path:inset(30% 0 30% 0)}}
@keyframes g2{0%,84%,100%{transform:translate(2px,0);clip-path:inset(55% 0 0 0)}86%{transform:translate(9px,1px);clip-path:inset(50% 0 10% 0)}92%{transform:translate(-6px,2px);clip-path:inset(70% 0 5% 0)}}
.hero-sub{font-family:var(--ui);font-size:20px;color:var(--cyan);margin:10px 0 18px}
.hero-sub .sep{color:var(--amber)}
.hero-p{color:var(--text);max-width:520px;margin-bottom:24px}
.btns{display:flex;gap:12px;flex-wrap:wrap}
.btn{font-family:var(--ui);font-weight:600;letter-spacing:1.5px;padding:10px 20px;border:1px solid var(--green);color:var(--green);background:transparent;cursor:pointer;font-size:13px;transition:.2s}
.btn:hover,.btn:focus,.btn:active{background:var(--green);color:#000!important;box-shadow:0 0 20px var(--green)}
.btn.c{border-color:var(--cyan);color:var(--cyan)}
.btn.c:hover,.btn.c:focus,.btn.c:active{background:var(--cyan);color:#000!important;box-shadow:0 0 20px var(--cyan)}
.stats{display:flex;gap:26px;margin-top:30px;flex-wrap:wrap}
.stat b{display:block;font-family:var(--disp);font-size:38px;color:var(--amber);letter-spacing:2px;font-weight:400;line-height:1}
.stat span{color:var(--dim);font-size:11px;letter-spacing:1px;text-transform:uppercase}

/* terminal window */
.win{background:var(--panel);border:1px solid var(--line);box-shadow:0 0 30px rgba(0,229,255,.08),inset 0 0 40px rgba(0,0,0,.4)}
.win-bar{display:flex;align-items:center;gap:7px;padding:8px 12px;border-bottom:1px solid var(--line);background:#0a1115;font-family:var(--ui);font-size:12px;color:var(--dim)}
.win-bar i{width:10px;height:10px;border-radius:50%;display:inline-block}
.win-bar i:nth-child(1){background:var(--red)}.win-bar i:nth-child(2){background:var(--amber)}.win-bar i:nth-child(3){background:var(--green)}
.win-bar span{margin-left:8px}
.term{padding:16px;min-height:330px;font-size:13px;white-space:pre-wrap;word-break:break-word}
.p{color:var(--green)}.pa{color:var(--amber)}.pc{color:var(--cyan)}.pd{color:var(--dim)}.pr{color:var(--red)}
.caret{display:inline-block;width:8px;height:15px;background:var(--green);vertical-align:text-bottom;animation:blink 1s steps(1) infinite}

/* SKILLS */
.grid{display:grid;gap:16px}
.skills{grid-template-columns:repeat(auto-fit,minmax(310px,1fr))}
.card{background:var(--panel);border:1px solid var(--line);padding:18px;position:relative;transition:.25s}
.card::before{content:"";position:absolute;top:-1px;left:-1px;width:14px;height:14px;border-top:2px solid var(--green);border-left:2px solid var(--green)}
.card::after{content:"";position:absolute;bottom:-1px;right:-1px;width:14px;height:14px;border-bottom:2px solid var(--cyan);border-right:2px solid var(--cyan)}
.card:hover{border-color:var(--green);box-shadow:0 0 22px rgba(57,255,20,.14);transform:translateY(-3px)}
.card h3{font-family:var(--ui);font-size:15px;letter-spacing:2px;color:var(--cyan);margin-bottom:12px;font-weight:700}
.card h3 em{font-style:normal;color:var(--amber);margin-right:8px}
.chips{display:flex;flex-wrap:wrap;gap:7px}
.chip{font-size:12px;padding:3px 9px;border:1px solid var(--line);color:var(--text);background:#081014;transition:.15s}
.chip:hover{border-color:var(--green);color:var(--green);background:rgba(57,255,20,.07)}
.meter{margin-top:14px}
.meter div{display:flex;justify-content:space-between;font-size:11px;color:var(--dim);margin-bottom:3px}
.meter .b{height:5px;background:#0b1a1f}
.meter .b i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--green),var(--cyan));box-shadow:0 0 8px var(--green);transition:width 1.4s ease}

/* TIMELINE */
.tl{position:relative;padding-left:34px}
.tl::before{content:"";position:absolute;left:9px;top:4px;bottom:4px;width:2px;background:linear-gradient(var(--green),var(--cyan),var(--amber))}
.ev{position:relative;margin-bottom:22px;background:var(--panel);border:1px solid var(--line);padding:16px 18px;transition:.25s;cursor:pointer}
.ev:hover{border-color:var(--green);box-shadow:0 0 24px rgba(57,255,20,.18);transform:translateX(4px)}
.ev::before{content:"";position:absolute;left:-31px;top:20px;width:12px;height:12px;background:var(--bg);border:2px solid var(--green);box-shadow:0 0 10px var(--green);transform:rotate(45deg)}
.ev.am::before{border-color:var(--amber);box-shadow:0 0 10px var(--amber)}
.ev.cy::before{border-color:var(--cyan);box-shadow:0 0 10px var(--cyan)}
.ev .when{font-family:var(--ui);font-size:12px;color:var(--amber);letter-spacing:2px}
.ev h3{font-family:var(--ui);font-size:18px;color:#fff;margin:2px 0}
.ev .org{color:var(--cyan);font-size:13px;margin-bottom:6px}
.ev p{color:var(--text);font-size:13px}
.ev .ev-hint{display:flex;align-items:center;justify-content:flex-end;margin-top:10px;font-family:var(--ui);font-size:11px;color:var(--dim);letter-spacing:1px;transition:.2s}
.ev:hover .ev-hint{color:var(--green)}
.badge{display:inline-block;font-family:var(--ui);font-size:11px;letter-spacing:1px;padding:1px 8px;margin-right:6px;border:1px solid var(--amber);color:var(--amber)}
.badge.g{border-color:var(--green);color:var(--green)}

/* PROJECTS */
.projects{grid-template-columns:repeat(auto-fit,minmax(420px,1fr))}
.proj{display:flex;flex-direction:column}
.proj .top{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}
.proj .id{color:var(--dim);font-size:11px}
.status{font-size:11px;font-family:var(--ui);letter-spacing:1px;padding:1px 8px;border:1px solid var(--green);color:var(--green)}
.status.dev{border-color:var(--amber);color:var(--amber)}
.proj h3{font-family:var(--ui);font-size:21px;color:#fff;letter-spacing:1px;margin-bottom:4px}
.proj ul{list-style:none;margin:10px 0 14px}
.proj li{font-size:13px;padding-left:18px;position:relative;margin-bottom:5px}
.proj li::before{content:">";position:absolute;left:0;color:var(--green)}
.proj .chips{margin-top:auto}
.proj .chip{color:var(--cyan);border-color:#0f3640}
.proj-action{margin-top:16px;padding-top:14px;border-top:1px dashed var(--line);display:flex;align-items:center;gap:10px}
.proj-action .btn{padding:7px 15px;font-size:12px;display:inline-flex;align-items:center;gap:8px}

/* EDUCATION */
.edu-grid{grid-template-columns:repeat(auto-fit,minmax(380px,1fr))}
.edu{display:flex;flex-direction:column}
.edu .top{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}
.edu .when{font-family:var(--ui);font-size:12px;color:var(--amber);letter-spacing:2px}
.edu h3{font-family:var(--ui);font-size:20px;color:#fff;letter-spacing:1px;margin-bottom:4px}
.edu .org{color:var(--cyan);font-size:13px;margin-bottom:12px}
.edu .desc{font-size:13px;color:var(--text);margin-bottom:14px;line-height:1.6}
.edu .chips{margin-top:auto}

/* MODAL */
.modal-overlay{position:fixed;inset:0;background:rgba(5,8,10,.86);backdrop-filter:blur(6px);z-index:2000;display:flex;align-items:center;justify-content:center;padding:20px;opacity:0;pointer-events:none;transition:opacity .25s ease}
.modal-overlay.open{opacity:1;pointer-events:auto}
.modal-win{background:var(--panel);border:1px solid var(--green);box-shadow:0 0 35px rgba(57,255,20,.22),inset 0 0 30px rgba(0,0,0,.6);width:min(660px,94vw);max-height:86vh;display:flex;flex-direction:column;position:relative;transform:scale(.94);transition:transform .25s ease}
.modal-overlay.open .modal-win{transform:scale(1)}
.modal-win::before{content:"";position:absolute;top:-1px;left:-1px;width:16px;height:16px;border-top:2px solid var(--green);border-left:2px solid var(--green)}
.modal-win::after{content:"";position:absolute;bottom:-1px;right:-1px;width:16px;height:16px;border-bottom:2px solid var(--cyan);border-right:2px solid var(--cyan)}
.modal-close-btn{margin-left:auto;background:transparent;border:0;color:var(--dim);font-size:22px;line-height:1;cursor:pointer;padding:0 6px;transition:.2s}
.modal-close-btn:hover{color:var(--red)}
.modal-body{overflow-y:auto;padding:22px 24px;font-size:13px;line-height:1.65}
.modal-body h3{font-family:var(--ui);font-size:22px;color:#fff;margin:8px 0 4px;letter-spacing:1px}
.modal-body .m-meta{display:flex;gap:12px;align-items:center;flex-wrap:wrap;color:var(--amber);font-family:var(--ui);font-size:12px;letter-spacing:1px;margin-bottom:6px}
.modal-body .m-org{color:var(--cyan);font-size:13px;margin-bottom:14px}
.modal-body .m-sec{margin:14px 0 6px;color:var(--amber);font-family:var(--ui);font-size:12px;letter-spacing:1.5px}
.modal-body p{color:var(--text);margin-bottom:10px}
.modal-body ul{list-style:none;margin:8px 0 14px}
.modal-body li{padding-left:18px;position:relative;margin-bottom:6px;color:var(--text)}
.modal-body li::before{content:">";position:absolute;left:0;color:var(--green)}
.modal-body .m-chips{display:flex;flex-wrap:wrap;gap:6px;margin:10px 0 16px}
/* MODAL MINI TERMINAL */
.m-term-box{background:#060b0e;border:1px solid var(--line);box-shadow:inset 0 0 25px rgba(0,0,0,.6),0 0 16px rgba(0,229,255,.05);margin:6px 0 14px;border-radius:3px;overflow:hidden;font-size:12px;font-family:var(--mono);cursor:text;transition:border-color .2s,box-shadow .2s}
.m-term-box:focus-within{border-color:var(--green);box-shadow:inset 0 0 25px rgba(0,0,0,.6),0 0 16px rgba(57,255,20,.18)}
.m-term-bar{display:flex;align-items:center;gap:6px;padding:5px 10px;background:#091216;border-bottom:1px solid var(--line);font-family:var(--ui);font-size:11px;color:var(--dim);user-select:none}
.m-term-dots{display:flex;gap:5px;align-items:center}
.m-term-dots i{width:7px;height:7px;border-radius:50%;display:inline-block}
.m-term-dots i:nth-child(1){background:var(--red)}
.m-term-dots i:nth-child(2){background:var(--amber)}
.m-term-dots i:nth-child(3){background:var(--green)}
.m-term-title{margin-left:6px;color:var(--dim);font-family:var(--mono);font-size:11px}
.m-term-tag{margin-left:auto;color:var(--green);font-size:10px;letter-spacing:1px;font-family:var(--mono);font-weight:600}
.m-term-body{padding:8px 12px;display:flex;flex-direction:column;gap:3px;line-height:1.45;max-height:85px;overflow-y:auto}
.m-term-line{white-space:pre-wrap;word-break:break-word;color:var(--text);font-size:12px}
.m-term-in-row{display:flex;align-items:center;gap:6px;font-size:12px}
.m-term-in{flex:1;background:transparent;border:0;outline:0;color:#fff;font-family:var(--mono);font-size:12px;caret-color:var(--green);padding:0;margin:0}
.m-term-in:focus + .caret{display:none}
.modal-body .m-actions{display:flex;justify-content:space-between;align-items:center;border-top:1px dashed var(--line);padding-top:14px;margin-top:10px;gap:12px;flex-wrap:wrap}

/* CONTACT */
.contact{display:grid;grid-template-columns:1fr 1.3fr;gap:20px}
.info .row{display:flex;gap:12px;padding:10px 0;border-bottom:1px dashed var(--line)}
.info .row:last-child{border:0}
.info .k{color:var(--amber);width:90px;flex-shrink:0;font-family:var(--ui);font-size:12px;letter-spacing:1px;padding-top:2px}
.info .v{word-break:break-all}
.cterm{height:420px;display:flex;flex-direction:column}
.cterm .out{flex:1;overflow-y:auto;padding:14px 16px 0;font-size:13px;white-space:pre-wrap;word-break:break-word}
.cterm .inp{display:flex;gap:8px;align-items:center;padding:10px 16px;border-top:1px solid var(--line)}
.cterm input{flex:1;background:transparent;border:0;outline:0;color:#fff;font-family:var(--mono);font-size:13px;caret-color:var(--green)}
@keyframes termGlitch{
  0%{box-shadow:0 0 60px rgba(255,59,92,.9),inset 0 0 50px rgba(255,59,92,.5);border-color:var(--red);transform:translateX(-7px)}
  20%{transform:translateX(7px) translateY(-3px)}
  40%{transform:translateX(-6px) translateY(3px)}
  60%{transform:translateX(5px) translateY(-2px)}
  80%{transform:translateX(-3px)}
  100%{box-shadow:0 0 30px rgba(0,229,255,.08),inset 0 0 40px rgba(0,0,0,.4);border-color:var(--line);transform:none}
}
.cterm-alert{animation:termGlitch .65s cubic-bezier(.36,.07,.19,.97) both}
.cterm-alert .win-bar{background:#2a050d!important;color:var(--red)!important;border-bottom-color:var(--red)!important}
@keyframes termGlitchGranted{
  0%{box-shadow:0 0 60px rgba(57,255,20,.95),inset 0 0 50px rgba(57,255,20,.5);border-color:var(--green);transform:translateX(-7px)}
  20%{transform:translateX(7px) translateY(-3px)}
  40%{transform:translateX(-6px) translateY(3px)}
  60%{transform:translateX(5px) translateY(-2px)}
  80%{transform:translateX(-3px)}
  100%{box-shadow:0 0 30px rgba(0,229,255,.08),inset 0 0 40px rgba(0,0,0,.4);border-color:var(--line);transform:none}
}
.cterm-granted{animation:termGlitchGranted .65s cubic-bezier(.36,.07,.19,.97) both}
.cterm-granted .win-bar{background:#04210e!important;color:var(--green)!important;border-bottom-color:var(--green)!important}
footer{position:relative;z-index:1;text-align:center;padding:30px 20px 50px;color:var(--dim);font-size:12px;border-top:1px solid var(--line);margin-top:60px}
footer b{color:var(--green)}

.reveal{opacity:0;transform:translateY(22px);transition:opacity .7s,transform .7s}
.reveal.in{opacity:1;transform:none}

@media(max-width:900px){
  #home{grid-template-columns:1fr;padding-top:100px}
  .contact{grid-template-columns:1fr}
  .projects{grid-template-columns:1fr}
  .edu-grid{grid-template-columns:1fr}
  nav .sys .hide{display:none}
}
@media(max-width:560px){nav .logo{display:none}.sec-title h2{font-size:36px}.sec-title .cmd{display:none}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}

/* FULL-SITE SHAKE & ACCESS DENIED NOTIFICATION */
@keyframes siteShake{
  0%{transform:translate(0,0)}
  10%{transform:translate(-14px,-8px) rotate(-0.5deg)}
  20%{transform:translate(14px,8px) rotate(0.5deg)}
  30%{transform:translate(-12px,6px) rotate(-0.3deg)}
  40%{transform:translate(12px,-6px) rotate(0.3deg)}
  50%{transform:translate(-9px,-4px)}
  60%{transform:translate(9px,4px)}
  70%{transform:translate(-6px,2px)}
  80%{transform:translate(4px,-2px)}
  90%{transform:translate(-2px,1px)}
  100%{transform:translate(0,0) rotate(0deg)}
}
body.site-shake{
  animation:siteShake .7s cubic-bezier(.36,.07,.19,.97) both!important;
  box-shadow:inset 0 0 100px rgba(255,59,92,.75)!important;
}
body.site-shake::after{
  background:radial-gradient(ellipse at center,rgba(255,20,50,.18) 20%,rgba(255,0,40,.65))!important;
}
body.site-shake-granted{
  animation:siteShake .7s cubic-bezier(.36,.07,.19,.97) both!important;
  box-shadow:inset 0 0 100px rgba(57,255,20,.75)!important;
}
body.site-shake-granted::after{
  background:radial-gradient(ellipse at center,rgba(57,255,20,.2) 20%,rgba(0,229,255,.55))!important;
}
.cyber-notify{
  position:fixed;top:20px;left:50%;transform:translateX(-50%) translateY(-140%);
  z-index:10000;width:min(520px,92vw);background:#0d0205;border:1px solid var(--red);
  box-shadow:0 0 40px rgba(255,59,92,.6),inset 0 0 25px rgba(255,0,40,.3);
  padding:14px 18px;display:flex;align-items:center;gap:14px;opacity:0;pointer-events:none;
  transition:transform .4s cubic-bezier(.175,.885,.32,1.275),opacity .3s ease;
}
.cyber-notify.show{transform:translateX(-50%) translateY(0);opacity:1;pointer-events:auto}
.cyber-notify::before{content:"";position:absolute;top:-1px;left:-1px;width:12px;height:12px;border-top:2px solid #fff;border-left:2px solid #fff}
