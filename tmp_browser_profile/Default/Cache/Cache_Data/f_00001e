      if(low === 'exit'){
        closeEvModal();
        return;
      }
      if(low === 'clear'){
        body.innerHTML = `
          <div class="m-term-line"><span class="p">guest@bala-os:~/${esc(dir)}$</span> <span class="pc">${esc(cmd)}</span></div>
          <div class="m-term-line">${outText}</div>
          <div class="m-term-in-row">
            <span class="p">guest@bala-os:~/${esc(dir)}$</span>
            <input class="m-term-in" id="mTermIn" autocomplete="off" spellcheck="false" aria-label="mini terminal prompt">
            <span class="caret"></span>
          </div>
        `;
        bindMiniTerm(itemData, dir, cmd, outText);
        const nextIn = $('#mTermIn');
        if(nextIn) nextIn.focus();
        return;
      }
      let reply = '';
      if(low === 'help'){
        reply = '<span class="pc">Available:</span> status, verify, whoami, linkedin, clear, exit';
      } else if(low === 'status'){
        reply = `<span class="pa">[STATUS]</span> ${esc(itemData.title)} &bull; ${esc(itemData.org)}`;
      } else if(low === 'verify' || low === 'run'){
        reply = outText;
      } else if(low === 'whoami'){
        reply = 'Balamurugan S // CTF player &amp; Cyber Security student';
      } else if(low === 'linkedin'){
        window.open(itemData.linkedinUrl || 'https://www.linkedin.com/in/balamurugan-s-62a119339/', '_blank');
        reply = '<span class="p">[OK]</span> Opening LinkedIn in new tab...';
      } else {
        reply = `<span class="pr">bash: ${esc(v)}: command not found</span> (try: 'help' or 'exit')`;
      }
      const cmdRow = document.createElement('div');
      cmdRow.className = 'm-term-line';
      cmdRow.innerHTML = `<span class="p">guest@bala-os:~/${esc(dir)}$</span> ${esc(v)}`;
      const replyRow = document.createElement('div');
      replyRow.className = 'm-term-line';
      replyRow.innerHTML = reply;
      const inRow = input.closest('.m-term-in-row');
      body.insertBefore(cmdRow, inRow);
      body.insertBefore(replyRow, inRow);
      body.scrollTop = body.scrollHeight;
    }
  });
}

function closeEvModal(){
  if(!modal.classList.contains('open')) return;
  modal.classList.remove('open');
  modal.setAttribute('aria-hidden', 'true');
  document.body.style.overflow = '';
}

$$('[data-item]').forEach(el => {
  el.addEventListener('click', () => openEvModal(el.dataset.item));
});

modal.addEventListener('click', e => {
  if(e.target === modal) closeEvModal();
});
$('#modalCloseX').addEventListener('click', closeEvModal);
document.addEventListener('keydown', e => {
  if(e.key === 'Escape') closeEvModal();
});
})();
</script>
</body>
</html>
